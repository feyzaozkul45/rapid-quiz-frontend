# Backend API taban adresi (derleme anında pakete gömülür)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# İlk isteklerin zaman aşımı (ms). Production'da Render ücretsiz servisi uykudan uyanırken
# 30-60 sn sürebildiği için varsayılan 90000'dir (değişken verilmezse). Yerelde 0: koruma kapalı,
# backend yoksa hata hemen görünür.
VITE_COLD_START_TIMEOUT_MS=0
